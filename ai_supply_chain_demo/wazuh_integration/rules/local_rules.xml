<!--
  [Wazuh Manager 커스텀 룰]

  이 내용을 Wazuh Manager의 /var/ossec/etc/rules/local_rules.xml 에 추가하고
  매니저를 재시작(systemctl restart wazuh-manager)하세요.

  룰 ID는 사용자 정의 룰용 예약 대역인 100000번대를 사용했습니다.
  (100000~119999는 기본 룰과 절대 겹치지 않는 안전한 대역)

  ⚠️ JSON 로그의 필드 경로(payload.event 등)와 syscheck 관련 상위 룰 ID(554 등)는
  Wazuh 버전에 따라 조금씩 다를 수 있습니다. 배포 전에 반드시
  `wazuh-logtest` (또는 /var/ossec/bin/ossec-logtest) 로 artifacts/c2_log.jsonl의
  실제 한 줄을 넣어 필드가 예상대로 분해되는지 확인한 뒤 rule id/필드명을 맞추세요.
  (README.md 3번 항목에 검증 절차가 있습니다)
-->

<group name="ai_supply_chain_demo,">

  <!-- ===== 0) 베이스 룰: C2 서버로 온 모든 beacon ===== -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="path">/beacon</field>
    <description>[AI 공급망 공격 데모] C2 서버(127.0.0.1:8899)로 beacon 수신</description>
    <group>ai_supply_chain_demo,</group>
  </rule>

  <!-- ===== 1) 경로별 세부 룰 ===== -->

  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="payload.event">pip_package_beacon</field>
    <description>[AI 공급망 공격] 악성 pip 패키지(ai-lint-helper) 설치/사용 시 beacon 탐지</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1071.001</id>
      <id>T1005</id>
    </mitre>
    <group>ai_supply_chain_demo,supply_chain,</group>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="payload.event">mcp_tool_call_beacon</field>
    <description>[AI 공급망 공격] 악성 MCP 서버(smart-code-formatter) 도구 호출 시 beacon 탐지</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1071.001</id>
      <id>T1005</id>
    </mitre>
    <group>ai_supply_chain_demo,supply_chain,mcp,</group>
  </rule>

  <rule id="100103" level="12">
    <if_sid>100100</if_sid>
    <field name="payload.event">pickle_model_load_beacon</field>
    <description>[AI 공급망 공격] 오염된 pickle 모델 파일 로드(역직렬화) 시 beacon 탐지 - RCE 의심</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1204</id>
      <id>T1071.001</id>
    </mitre>
    <group>ai_supply_chain_demo,supply_chain,deserialization,</group>
  </rule>

  <!-- ===== 2) FIM 기반: 지속성(Persistence) 시뮬레이션 흔적 파일 생성 =====
       상위 룰 id는 배포 환경의 기본 룰셋에서 "syscheck: New file added"에
       해당하는 id로 맞춰야 합니다 (참고용으로 554를 사용했습니다). -->
  <rule id="100110" level="12">
    <if_sid>554</if_sid>
    <field name="file">SIMULATED_persistence_marker</field>
    <description>[AI 공급망 공격] 지속성(Persistence) 시뮬레이션 흔적 파일 생성 탐지</description>
    <mitre>
      <id>T1547</id>
    </mitre>
    <group>ai_supply_chain_demo,persistence,</group>
  </rule>

  <!-- 참고용 FIM 룰: poisoned_model 폴더에 새 .pkl 파일이 생기면 낮은 심각도로 알림
       (실제로는 정상적인 모델 배포도 여기 걸릴 수 있으므로 level을 낮게 잡음) -->
  <rule id="100111" level="6">
    <if_sid>554</if_sid>
    <field name="file">\.pkl$</field>
    <description>[AI 공급망 공격] 새 pickle(.pkl) 모델 파일 생성 감지 - 출처 확인 필요</description>
    <group>ai_supply_chain_demo,file_monitor,</group>
  </rule>

  <!-- ===== 3) 상관분석(Correlation) 룰: 짧은 시간 내 서로 다른 침투 경로에서
       동시에 beacon이 발생하면 "다중 벡터 공급망 공격"으로 격상 =====
       (여러 팀이 각자 시나리오를 데모할 때, 혹은 실제로 여러 경로가 동시에
       악용됐을 때를 흉내내는 상황을 잡기 위한 상위 레벨 알림) -->
  <rule id="100120" level="14" frequency="2" timeframe="300">
    <if_matched_group>ai_supply_chain_demo</if_matched_group>
    <description>[AI 공급망 공격] 5분 내 동일 C2로 서로 다른 침투 경로의 beacon 다중 탐지 - 다중 벡터 공급망 공격 의심</description>
    <mitre>
      <id>T1195</id>
    </mitre>
    <group>ai_supply_chain_demo,correlation,</group>
  </rule>

</group>
